# OpenShorts local setup
# Copy this file to .env and fill the two blank credential values.

# Keep generated videos, metadata and thumbnails on this machine.
# AWS credentials below are used only for Bedrock, never for S3.
LOCAL_STORAGE_ONLY=1

# AI fallback: 3 attempts on Bedrock, then 3 attempts on Gemini.
LLM_FALLBACK_ORDER=bedrock,gemini
BEDROCK_ENABLED=1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Recommended for a local Bedrock trial: create a Bedrock API key in the AWS
# console and paste it here. AWS says development keys expire after 30 days.
AWS_BEARER_TOKEN_BEDROCK=

# Fallback key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Direct YouTube publishing. Generate this file with youtube_auth.py first.
SOCIAL_PUBLISH_BACKEND=direct
SOCIAL_PUBLISH_MAX_ATTEMPTS=3
SOCIAL_PLATFORMS=youtube
YOUTUBE_TOKEN_PATH=secrets/youtube_token.json

# Local files are retained for seven days. Raise this if desired.
JOB_RETENTION_SECONDS=604800

# Optional: cookies can help yt-dlp with age-gated/private source videos.
# YOUTUBE_COOKIES=
ode:
# this repository is public). LIFECYCLE_EMAILS_DISABLED=1 turns all four off.
# WINBACK_PROMO_CODE=
# WINBACK_PROMO_LABEL=50% off your first month
# LIFECYCLE_EMAILS_DISABLED=0
